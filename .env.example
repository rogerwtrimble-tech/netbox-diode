# Copy is generated by `make init` (scripts/init_secrets.py). Every CHANGE_ME is
# replaced with a unique random secret; do not commit the resulting .env.
COMPOSE_PROJECT_NAME=netbox-diode

# --- Published ports -------------------------------------------------------
NETBOX_PORT=8000
DIODE_PORT=8080

# Optional: CA bundle for a TLS-inspecting proxy, used only during image builds.
# EXTRA_CA_BUNDLE=/etc/ssl/certs/corp-ca-bundle.pem

# --- NetBox ----------------------------------------------------------------
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com
NETBOX_SUPERUSER_PASSWORD=CHANGE_ME
# v2 API token (Authorization: Bearer nbt_<KEY>.<TOKEN>) used by the recon tool
NETBOX_API_KEY=CHANGE_ME_ALNUM12
NETBOX_API_TOKEN=CHANGE_ME_ALNUM40
NETBOX_SECRET_KEY=CHANGE_ME_LONG
NETBOX_API_TOKEN_PEPPER=CHANGE_ME_LONG
NETBOX_DB_PASSWORD=CHANGE_ME
NETBOX_REDIS_PASSWORD=CHANGE_ME
NETBOX_REDIS_CACHE_PASSWORD=CHANGE_ME

# --- Diode server ----------------------------------------------------------
DIODE_LOGGING_LEVEL=INFO
DIODE_REDIS_PASSWORD=CHANGE_ME
DIODE_POSTGRES_ROOT_PASSWORD=CHANGE_ME
DIODE_POSTGRES_PASSWORD=CHANGE_ME
HYDRA_POSTGRES_PASSWORD=CHANGE_ME
HYDRA_SECRETS_SYSTEM=CHANGE_ME_LONG
# Filled from secrets/oauth2/client-credentials.json by init_secrets.py
DIODE_TO_NETBOX_CLIENT_SECRET=FROM_CREDENTIALS
DIODE_INGEST_CLIENT_SECRET=FROM_CREDENTIALS
